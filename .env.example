# Bot Configuration
TOKEN=your_telegram_bot_token
OWNER_CHAT_ID=             # opsional; jika kosong, user pertama menjadi owner

# Database Configuration
MONGO_URL=mongodb://username:password@localhost:27017/database_name

# TokoVoucher Configuration
member_code=your_member_code
signature=your_signature              # Optional, will be auto-generated
secret=your_secret_key
TOV_USE_GET=0                          # Set to 1 only if legacy GET with secret in query is required
TOV_TIMEOUT_MS=15000

# Digiflazz Configuration
username=your_digiflazz_username
apikey=your_digiflazz_apikey

# Provider Webhooks (production)
HEROKU_URL=https://your-domain.example.com
PORT=3000
TELEGRAM_WEBHOOK_PATH=               # optional; default /telegraf/<secret>
DIGIFLAZZ_WEBHOOK_PATH=/webhooks/digiflazz
DIGIFLAZZ_WEBHOOK_SECRET=            # set this to the webhook secret configured in Digiflazz dashboard
TOKOVOUCHER_WEBHOOK_PATH=/webhooks/tokovoucher
REQUIRE_TOKOVOUCHER_WEBHOOK_AUTH=1   # validates X-TokoVoucher-Authorization = md5(member_code:secret:ref_id)
TOKOVOUCHER_WEBHOOK_TOKEN=           # optional extra shared token if you add ?token=... or x-webhook-token
WEBHOOK_NOTIFY_ENABLED=1
WEBHOOK_NOTIFY_CHAT_ID=               # optional owner/admin summary target; fallback OWNER_CHAT_ID
WEBHOOK_NOTIFY_DUPLICATES=0           # 1 = notify repeated webhook even if status/SN unchanged
WEBHOOK_MAX_BODY_BYTES=65536

TZ=Asia/Makassar
# Note:
# 1. Rename this file to .env
# 2. Replace all placeholder values with your actual credentials
# 3. Never commit the actual .env file to version control
