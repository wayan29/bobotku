# Bot Configuration
TOKEN=your_telegram_bot_token
OWNER_CHAT_ID=             # opsional; jika kosong, user pertama menjadi owner

# Database Configuration
MONGO_URL=mongodb://username:password@localhost:27017/database_name

# TokoVoucher Configuration
member_code=your_member_code
signature=your_signature              # Optional, will be auto-generated
secret=your_secret_key
TOV_USE_GET=0                          # Set to 1 only if legacy GET with secret in query is required
TOV_TIMEOUT_MS=15000

# Digiflazz Configuration
username=your_digiflazz_username
apikey=your_digiflazz_apikey
TZ=Asia/Makassar
# Note:
# 1. Rename this file to .env
# 2. Replace all placeholder values with your actual credentials
# 3. Never commit the actual .env file to version control
